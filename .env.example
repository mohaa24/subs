# Neon DB - get from https://neon.tech (connection string includes ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Digital Ocean droplet - replace with your droplet IP or domain
NEXT_PUBLIC_API_URL=http://YOUR_DROPLET_IP:4000
FE_ORIGIN=http://YOUR_DROPLET_IP:3000

# Use a strong secret in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
